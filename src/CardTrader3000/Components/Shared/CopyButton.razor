@inject IJSRuntime JS
@implements IDisposable

<button type="button" class="btn btn-sm @(_copied ? "btn-success" : "btn-outline-primary")" @onclick="CopyAsync" disabled="@string.IsNullOrEmpty(Text)">
    <i class="mdi @(_copied ? "mdi-check" : "mdi-content-copy") me-1"></i>@(_copied ? "Copied" : Label)
</button>

@code {
    [Parameter, EditorRequired] public string? Text { get; set; }
    [Parameter] public string Label { get; set; } = "Copy";

    private bool _copied;
    private CancellationTokenSource? _reset;

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(Text)) return;

        // Uses the browser clipboard API directly; no custom JavaScript file needed.
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Text);

        _copied = true;
        _reset?.Cancel();
        _reset = new CancellationTokenSource();
        try
        {
            await Task.Delay(1500, _reset.Token);
            _copied = false;
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose() => _reset?.Cancel();
}
