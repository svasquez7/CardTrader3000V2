@if (Sgc == SgcCandidate.HighProspect)
{
    <span class="badge badge-outline-warning" title="SGC High Prospect"><i class="mdi mdi-star me-1"></i>High</span>
}
else if (Sgc == SgcCandidate.Secondary)
{
    <span class="badge badge-outline-info" title="SGC Secondary">Secondary</span>
}
else
{
    <span class="text-muted">—</span>
}

@code {
    [Parameter, EditorRequired] public SgcCandidate Sgc { get; set; }
}
