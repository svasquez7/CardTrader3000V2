@using CardTrader3000.Services.Inventory

<th class="ct-sortable @CssClass" @onclick="() => OnSort.InvokeAsync(Column)" aria-sort="@AriaSort">
    @Label
    @if (Current == Column)
    {
        <i class="mdi @(Descending ? "mdi-arrow-down" : "mdi-arrow-up")"></i>
    }
</th>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public InventorySort Column { get; set; }
    [Parameter, EditorRequired] public InventorySort Current { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback<InventorySort> OnSort { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private string AriaSort => Current != Column ? "none" : Descending ? "descending" : "ascending";
}
